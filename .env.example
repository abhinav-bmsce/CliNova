# CLINOVA Platform Environment Configuration
# Discover Beyond Data

# Backend Environment
ENVIRONMENT=development
DEBUG=True
PORT=5050
HOST=127.0.0.1
SECRET_KEY=clinova_development_secret_key_change_in_production_9985456b

# Database Configuration (PostgreSQL / SQLite fallback for local development)
DATABASE_URL=sqlite:///./storage/clinova.db
# DATABASE_URL=postgresql://clinova_user:clinova_pass@localhost:5432/clinova_db

# JWT Authentication
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# Storage Paths
STORAGE_PATH=./storage
RAW_DATASETS_PATH=./storage/raw
PROCESSED_DATASETS_PATH=./storage/processed
REPORTS_PATH=./storage/reports

# External AI Service (Optional LLM Integration for Knowledge Assistant)
# Backend includes full rule-based analytical grounding fallback when unset
OPENAI_API_KEY=
GEMINI_API_KEY=

# CORS Configuration
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

